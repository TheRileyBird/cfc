---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
---

<Layout
  title="Wholesale Access — CFC Skincare"
  description="Wholesale access for approved CFC Skincare partners, providers, and company buyers."
  showNewsletter={false}
>
  <Nav />

  <main>
    <section data-wholesale-hero class="bg-parchment border-b border-rule min-h-[calc(85vh-96px)] pt-[132px] pb-16 flex items-center">
      <div class="max-w-[760px] mx-auto w-full px-6 sm:px-10">
        <div class="reveal text-center" data-wholesale-gate>
          <div class="mb-6 flex items-center justify-center gap-4">
            <div class="h-px bg-gold w-8"></div>
            <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-gold">Wholesale Access</span>
            <div class="h-px bg-gold w-8"></div>
          </div>
          <h1
            class="font-display font-light text-ink leading-[1.02] tracking-[-0.01em] mb-5"
            style="font-size: clamp(38px, 5vw, 58px);"
          >
            Sign in to shop wholesale.
          </h1>
          <p class="mx-auto font-sans font-light text-[15px] leading-[1.75] max-w-[520px] text-ink-soft">
            Sign in with the email assigned to your company location to view wholesale products, pricing, and checkout terms.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row sm:justify-center gap-3">
            <button
              type="button"
              data-wholesale-login
              class="inline-flex items-center justify-center bg-ink px-8 py-4 font-mono text-[10px] tracking-[0.18em] uppercase text-white transition-colors duration-200 hover:bg-gold hover:text-ink"
            >
              Enter Wholesale
            </button>
            <a
              href="/contact"
              class="inline-flex items-center justify-center border border-rule bg-white px-8 py-4 font-mono text-[10px] tracking-[0.18em] uppercase text-ink transition-colors duration-200 hover:border-gold hover:text-gold"
            >
              Request Access
            </a>
          </div>
          <p class="mx-auto mt-5 hidden max-w-[520px] font-sans text-[13px] leading-relaxed text-ink-soft" data-wholesale-public-status></p>
        </div>

        <div data-wholesale-store class="hidden">
          <div class="text-center">
            <div class="mb-5 flex items-center justify-center gap-4">
              <div class="h-px bg-gold w-8"></div>
              <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-gold">Wholesale Account</span>
              <div class="h-px bg-gold w-8"></div>
            </div>
            <h1 class="font-display font-light text-ink leading-tight tracking-[-0.01em]" style="font-size: clamp(34px, 4vw, 50px);" data-wholesale-location>
              Wholesale account
            </h1>
            <p class="mx-auto mt-4 max-w-[520px] font-sans text-[14px] leading-relaxed text-ink-soft" data-wholesale-status>
              Loading wholesale products...
            </p>
            <div class="mt-7 flex flex-col sm:flex-row sm:justify-center gap-3">
              <a
                href="#wholesale-products"
                class="inline-flex items-center justify-center bg-ink px-7 py-3 font-mono text-[10px] tracking-[0.18em] uppercase text-white transition-colors duration-200 hover:bg-gold hover:text-ink"
              >
                View Products
              </a>
              <a
                href="#"
                data-wholesale-checkout
                class="pointer-events-none opacity-40 inline-flex items-center justify-center border border-rule bg-white px-7 py-3 font-mono text-[10px] tracking-[0.18em] uppercase text-ink transition-colors duration-200 hover:border-gold hover:text-gold"
              >
                Checkout
              </a>
              <button
                type="button"
                data-wholesale-logout
                class="inline-flex items-center justify-center border border-rule bg-white px-7 py-3 font-mono text-[10px] tracking-[0.18em] uppercase text-ink-soft transition-colors duration-200 hover:border-ink hover:text-ink"
              >
                Sign Out
              </button>
            </div>
            <p class="mt-5 font-mono text-[10px] tracking-[0.14em] uppercase text-ink-soft" data-wholesale-cart>Cart empty</p>
          </div>
        </div>
      </div>
    </section>

    <section id="wholesale-products" data-wholesale-store class="hidden bg-white py-12">
      <div class="max-w-[1440px] mx-auto px-6 sm:px-10">
        <div class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <div class="flex items-center gap-4 mb-4">
              <div class="h-px bg-gold w-6"></div>
              <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-gold">Wholesale Products</span>
            </div>
            <h2 class="font-display font-light text-ink leading-none tracking-[-0.01em]" style="font-size: clamp(34px, 4vw, 48px);">
              Your catalog.
            </h2>
          </div>
        </div>
        <div data-wholesale-products class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6"></div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import '../lib/wholesale-client';
</script>
