SHOPIFY_STORE_DOMAIN=cfcskincare.myshopify.com
SHOPIFY_CHECKOUT_DOMAIN=cfcskincare.myshopify.com
SHOPIFY_API_VERSION=2024-01
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=

PUBLIC_SHOPIFY_STORE_DOMAIN=cfcskincare.myshopify.com
PUBLIC_SHOPIFY_CHECKOUT_DOMAIN=cfcskincare.myshopify.com
PUBLIC_SHOPIFY_API_VERSION=2024-01
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
PUBLIC_SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
PUBLIC_SHOPIFY_B2B_STOREFRONT_API_VERSION=2026-01
# Comma-separated Shopify product handles for the wholesale (B2B) catalog.
# These products are "Unlisted" in Shopify, which Shopify excludes from every
# list-type Storefront query (products(), collection.products(), search) no
# matter the filter or buyer context — they're only resolvable one at a time
# by exact handle, so the catalog's contents must be listed explicitly here.
# Leave blank to fall back to the built-in default list in wholesale-core.ts.
# Update this (and the default list in code) whenever the Back Bar catalog's
# product lineup changes in Shopify.
PUBLIC_SHOPIFY_WHOLESALE_PRODUCT_HANDLES=

# Internal-only products are hidden by TAG: tag a product "internal-test" in
# Shopify and it is dropped from every list query here, so no static product page
# is generated for it and it stays out of the shop grid, the sitemap, and the
# search box. The tag travels with the product, so renaming its handle to
# something unguessable cannot un-hide it. This var is only a secondary lever for
# a product that cannot be tagged — comma-separated handles, blank by default.
# Note these handles ship in the browser bundle (site search filters on them too),
# so prefer the tag. Hiding here is build-side only: also turn the product's
# Online Store channel OFF in Shopify so it drops off cfcskincare.myshopify.com.
PUBLIC_SHOPIFY_HIDDEN_PRODUCT_HANDLES=

# Local testing only. `true` makes `npm run dev` render the hidden products above
# so a test product's full add-to-cart/subscription/checkout flow can be run on
# localhost against real Shopify. NEVER set this in Netlify — it would publish
# the test products to the live site.
PUBLIC_SHOPIFY_SHOW_HIDDEN_PRODUCTS=false

# Comma-separated subscription groups the storefront may offer. Shopify reports
# a group's owner in SellingPlanGroup.appName, and Bold puts its own group ID
# there — the "ID#" beside each group in the Bold admin. Propel's leftover
# groups report no owner, so setting this excludes them. Blank shows every
# group, which is only correct while exactly one exists. Hiding a group only
# affects the storefront; Shopify keeps billing anyone already subscribed.
PUBLIC_SHOPIFY_SUBSCRIPTION_GROUP_IDS=

# Use only for local/CI test builds that should not call Shopify.
SHOPIFY_USE_MOCKS=false
PUBLIC_SHOPIFY_USE_MOCKS=false
